    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import os\n",
    "\n",
    "# 1. Create some dummy data\n",
    "data = {\n",
    "    'Category': ['Research', 'Development', 'Marketing', 'Sales'],\n",
    "    'Budget': [50000, 75000, 30000, 45000],\n",
    "    'Status': ['Complete', 'In Progress', 'Planned', 'In Progress']\n",
    "}\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "# 2. SAVE AS CSV\n",
    "# This creates a file in the /kaggle/working directory\n",
    "df.to_csv('project_budget_report.csv', index=False)\n",
    "print(\"✅ Success: 'project_budget_report.csv' created.\")\n",
    "\n",
    "# 3. SAVE AS IMAGE\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.barplot(x='Category', y='Budget', data=df, palette='viridis')\n",
    "plt.title('Department Budget Overview')\n",
    "\n",
    "# Saving the plot as a PNG file\n",
    "plt.savefig('budget_chart.png')\n",
    "print(\"✅ Success: 'budget_chart.png' created.\")\n",
    "\n",
    "# 4. List files to prove they exist\n",
    "print(\"\\n--- Current Output Files ---\")\n",
    "print(os.listdir('/kaggle/working'))"
   ]
