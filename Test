    "# 1. Import necessary libraries\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# 2. Create a sample dataset (Simulating a Sales Report)\n",
    "data = {\n",
    "    'Month': ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],\n",
    "    'Sales': [15000, 18000, 12000, 22000, 21000, 28000],\n",
    "    'Expenses': [8000, 9500, 7000, 11000, 10500, 12000]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "df['Profit'] = df['Sales'] - df['Expenses']\n",
    "\n",
    "# 3. Quick Data Inspection\n",
    "print(\"--- Dataset Summary ---\")\n",
    "print(df.describe())\n",
    "\n",
    "# 4. Data Visualization\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.lineplot(x='Month', y='Sales', data=df, marker='o', label='Sales', color='blue')\n",
    "sns.lineplot(x='Month', y='Profit', data=df, marker='s', label='Profit', color='green')\n",
    "\n",
    "plt.title('Monthly Sales and Profit Trends', fontsize=14)\n",
    "plt.xlabel('Month')\n",
    "plt.ylabel('Amount ($)')\n",
    "plt.grid(True, linestyle='--', alpha=0.6)\n",
    "plt.legend()\n",
    "\n",
    "# 5. Show the plot\n",
    "plt.show()\n",
    "\n",
    "# 6. Check Kaggle input directory (Tutorial Tip)\n",
    "import os\n",
    "print(\"\\n--- Available Files in Kaggle ---\")\n",
    "for dirname, _, filenames in os.walk('/kaggle/input'):\n",
    "    for filename in filenames:\n",
    "        print(os.path.join(dirname, filename))"
   ]
